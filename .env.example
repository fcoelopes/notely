# Variáveis de ambiente do Notely. Copie para a raiz do repositório:
#
#     cp .env.example .env
#
# O arquivo `.env` está no .gitignore. Os valores abaixo são de desenvolvimento
# local; não os reutilize em produção.
#
# A API lê o `.env` do diretório em que é iniciada, e o `./scripts/dev.sh` inicia
# a partir da raiz do repositório. Um `.env` em `backend/` seria ignorado.

# Conexão e armazenamento
NOTELY_DATABASE_URL=postgresql+asyncpg://notely:notely@localhost:5432/notely
NOTELY_CLAMAV_HOST=localhost
NOTELY_CLAMAV_PORT=3310
NOTELY_CLAMAV_TIMEOUT_SECONDS=30
# Serviço S3 compartilhado, iniciado fora do Compose do Notely. Exemplo local:
# NOTELY_S3_ENDPOINT_URL=http://127.0.0.1:9000
# NOTELY_S3_ACCESS_KEY_ID=<chave-exclusiva-do-notely>
# NOTELY_S3_SECRET_ACCESS_KEY=<segredo-exclusivo-do-notely>
NOTELY_S3_BUCKET=notely
NOTELY_S3_REGION=us-east-1
NOTELY_MAX_UPLOAD_BYTES=104857600

# Segredos do servidor.
#
# Cifram segredos em repouso: NOTELY_AUTH_SECRET_KEY protege o segredo do segundo
# fator (TOTP) e NOTELY_AI_SECRET_KEY protege a chave de modelo do usuário (BYOK).
# Sem elas a aplicação sobe e funciona normalmente, mas ativar o segundo fator e
# salvar a chave de modelo respondem 503, em vez de gravar o segredo em claro.
#
# Formato: chave Fernet, base64 urlsafe de 32 bytes. Gere uma chave distinta para
# cada variável:
#
#     backend/.venv/bin/python -c "from notely.core.security import SecretCipher; print(SecretCipher.generate_key())"
#
# Descomente e preencha as duas antes de usar o segundo fator ou o assistente.
# Trocar uma chave torna ilegíveis os segredos já gravados com ela: o segundo
# fator precisa ser reativado e a chave de modelo, recadastrada.
# NOTELY_AUTH_SECRET_KEY=
# NOTELY_AI_SECRET_KEY=
